# ==============================================================================
# TURBOBITS (turbobits.in) — PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# 1. Application URL (Used for OAuth callbacks, OpenGraph metadata, and links)
APP_URL="https://turbobits.in"
NEXT_PUBLIC_APP_URL="https://turbobits.in"

# 2. TiDB Cloud Serverless (MySQL-compatible) via Prisma ORM
# Format: mysql://<user>:<password>@<host>:4000/<database>?sslaccept=strict
DATABASE_URL=""

# 3. Auth.js (NextAuth v5) + Google OAuth (Web Studio Login)
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4. Phase 2 Mobile Auth (Kotlin Jetpack Compose Android App)
# Used to verify Google ID tokens from Android and issue signed Bearer JWTs
GOOGLE_ANDROID_CLIENT_ID=""
JWT_SECRET=""

# 5. Filebase S3-Compatible Object Storage (Presigned PUT Uploads)
FILEBASE_ENDPOINT="https://s3.filebase.com"
FILEBASE_REGION="us-east-1"
FILEBASE_BUCKET=""
FILEBASE_ACCESS_KEY_ID=""
FILEBASE_SECRET_ACCESS_KEY=""
FILEBASE_PUBLIC_BASE_URL="https://s3.filebase.com"

# 6. Optional Gemini API Key (Server-side only)
GEMINI_API_KEY=""
